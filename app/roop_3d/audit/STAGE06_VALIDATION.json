    "command": "PowerShell literal stdin script | roop_3d/.venv/Scripts/python.exe -B -u -",
    "stdin_script": "from dataclasses import asdict\nimport cv2\nimport numpy as np\nfrom roop_3d.audit.project_paths import application_root,legacy_root\nfrom roop_3d.core.storage import atomic_json\nfrom roop_3d.engine.runtime import RuntimeConfig\nfrom roop_3d.engine.volumetric.session import ReferencePipeline\nfrom roop_3d.engine.volumetric.preprocess import transform_points\nfrom roop_3d.faceset.faceset_reader import FaceSetReader\nreader=FaceSetReader()\nsource=reader.read(legacy_root()/'app/facesets/akansha.fsz')\ntarget=reader.read(legacy_root()/'app/facesets/anushree.fsz')\nview=min(target.views,key=lambda item:abs(item.yaw))\nimage=cv2.imdecode(np.frombuffer(view.image_bytes,np.uint8),cv2.IMREAD_COLOR)\nconfig=RuntimeConfig(provider='CUDAExecutionProvider',hardware_profile='12gb',cpu_threads=4)\nsession=ReferencePipeline(config=config)\ntry:\n    session.prepare_session(source,retarget='required')\n    result=session.infer_frame(image)\n    assert len(result.replacements)==1 and result.replacements[0].image.shape==(512,512,3)\n    replacement=result.replacements[0]\n    points=result.observations[0].observation.landmarks5\n    before=session.tracker.recognizer.embed(image,points)\n    mapped=transform_points(points,cv2.invertAffineTransform(replacement.inverse)).astype(np.float32)\n    after=session.tracker.recognizer.embed(replacement.image,mapped)\n    before_cos=float(np.dot(before,source.canonical_embedding))\n    after_cos=float(np.dot(after,source.canonical_embedding))\n    assert after_cos>before_cos+0.2\n    assert 0<config.gpu_budget_bytes<=((12288-config.reserve_mib)*1048576)\n    report={'status':'passed','scope':'one-frame functional check; not a 100-frame or physical-capacity qualification',\n            'profile':'12gb','gpu_budget_bytes':config.gpu_budget_bytes,'frames':1,\n            'source_cosine_before':before_cos,'source_cosine_after':after_cos,\n            'capabilities':session.capability(),'latency':asdict(result.latency)}\n    atomic_json(application_root(),'roop_3d/.runtime/acceptance/stage06-cuda-12gb-functional.json',report)\n    print({'status':report['status'],'profile':report['profile'],'frames':1,'gpu_budget_mib':config.gpu_budget_bytes//1048576,\n           'source_cosine_before':before_cos,'source_cosine_after':after_cos},flush=True)\nfinally:\n    session.release_session()\n    assert not session.prepared and not session.portrait.models\n",
    "exit_code": 0
  },
