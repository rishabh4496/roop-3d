# Roop 3D - Unified Gitignore

# Virtual environments
**/.venv/
**/venv/
**/env/
app/env/
app/env

# Python bytecode & test caches
**/__pycache__/
*.py[cod]
*$py.class
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/

# Node & Frontend build outputs
**/node_modules/
**/dist/
.vite/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Heavy weights & compiled TensorRT engines
app/models/
app/models
models/
roop_3d/models/
roop_3d/models/cache/
*.onnx
*.pth
*.pt
*.bin
*.safetensors
*.engine
*.trt
*.plan
trt_cache/
engines/

# Local facesets & media caches
app/facesets/
app/facesets
facesets/
*.fsz

# Local runtime data, logs, and outputs
cache/
.cache/
logs/
outputs/
.runtime/
*.part
*.log

# Secrets & local env
.env
.env.*
!.env.example

# Audit generated artifacts
app/roop_3d/audit/protected_all_paths.json
app/roop_3d/audit/stage00_verification.json
app/roop_3d/audit/stage01_verification.json
